; Tileh Bazi — independent native 3D project
config_version=5

[application]
config/name="Tileh Bazi: Marbles Game"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=720
window/size/viewport_height=1200
window/size/window_width_override=600
window/size/window_height_override=1000
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.48, 0.76, 0.90, 1)

[physics]
common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
3d/default_gravity=9.81
jolt_physics_3d/simulation/use_enhanced_internal_edge_removal=true
jolt_physics_3d/simulation/penetration_slop=0.0005
jolt_physics_3d/simulation/speculative_contact_distance=0.002
jolt_physics_3d/simulation/bounce_velocity_threshold=0.2

[gui]
theme/default_font_multichannel_signed_distance_field=true
